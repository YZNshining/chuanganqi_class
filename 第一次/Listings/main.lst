 228          void motor(uchar tmp)
 229          {
 230   1          uchar x;
 231   1          if(TempBuffer1[0]==0x2b)      // 正温度
 232   1          {
 233   2              if(tmp<25)                // 小于25度电机停止
 234   2              {
 235   3                  D=0;
 236   3                  PWM=0;
 237   3              }
 238   2              else if(tmp>50)           // 大于50度全速
 239   2              {
 240   3                  D=0;
C51 COMPILER V9.60.7.0   MAIN                                                              10/15/2026 14:30:19 PAGE 5   

 241   3                  PWM=1;
 242   3                  x=250;
 243   3                  delay_motor(x);
 244   3                  PWM=0;
 245   3                  x=5;
 246   3                  delay_motor(x);
 247   3              }
 248   2              else                       // 25~50度PWM调速
 249   2              {
 250   3                  D=0;
 251   3                  PWM=1;
 252   3                  x=5*tmp;
 253   3                  delay_motor(x);
 254   3                  PWM=0;
 255   3                  x=255-5*tmp;
 256   3                  delay_motor(x);
 257   3              }
 258   2          }
 259   1          else if(TempBuffer1[0]==0x2d) // 负温度电机反转
 260   1          {
 261   2              D=1;
 262   2              PWM=0;
 263   2              x=5*tmp;
 264   2              delay_motor(x);
 265   2              PWM=1;
 266   2              x=255-5*tmp;
 267   2              delay_motor(x);
 268   2          }
 269   1      }
