 123          /************************ 温度数据转换函数 ************************/
 124          void covert1(void)
 125          {
 126   1          uchar x=0x00;
 127   1          if(t[1]>0x07)                  // 判断负温度
 128   1          {
 129   2              TempBuffer1[0]=0x2d;       // '-'符号
 130   2              t[1]=~t[1];
 131   2              t[0]=~t[0];
 132   2              x=t[0]+1;
 133   2              t[0]=x;
 134   2              if(x>255)
 135   2                  t[1]++;
 136   2          }
 137   1          else
 138   1          {
 139   2              TempBuffer1[0]=0x2b;       // '+'符号
 140   2          }
 141   1      
 142   1          t[1]<<=4;
 143   1          t[1]=t[1]&0x70;
 144   1          x=t[0];
 145   1          x>>=4;
 146   1          x=x&0x0f;
 147   1          t[1]=t[1]|x;
 148   1          temperature=t[1];
 149   1      
 150   1          TempBuffer1[1]=t[1]/100+0x30;
 151   1          if(TempBuffer1[1]==0x30)
 152   1              TempBuffer1[1]=0xfe;       // 百位消隐
 153   1          TempBuffer1[2]=(t[1]%100)/10+0x30;
 154   1          TempBuffer1[3]=(t[1]%100)%10+0x30;
 155   1      }
