  24          // Timer0 中断：每 1ms 扫描一位数码管
  25          void timer0_scan(void) interrupt 1 using 1
  26          {
  27   1          unsigned char segments;
  28   1          TH0 = 0xfc;
  29   1          TL0 = 0x18;
  30   1          P1 = 0xff;                         // 先消隐
